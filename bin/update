#!/usr/bin/env bash
set -euo pipefail

# This script should be run from within: nix develop
# Or with: nix develop -c ./bin/update

echo "=== Updating yap dependencies ==="

echo "1. Running uv lock --upgrade..."
uv lock --upgrade

echo "2. Exporting requirements.txt..."
uv export --no-dev --no-editable -o requirements.txt

echo "3. Removing stray '.' from requirements.txt..."
sed -i '/^\\.$/d' requirements.txt
sed -i '/^\.$/d' requirements.txt

echo "4. Building FOD to get hash..."
nix build .#deps
DEPSPATH=$(nix path-info .#deps)
HASH=$(nix hash path "$DEPSPATH")
echo "   Got hash: $HASH"

# Sanity: every pinned version must have a wheel in the FOD. Guards against
# recording a hash from a build that saw a stale requirements.txt (this
# happened once — certifi pin vs FOD contents diverged, nix run broke).
MISSING=0
while IFS= read -r req; do
  pkg="${req%%==*}"
  ver="${req#*==}"
  if ! ls "$DEPSPATH" | grep -q "^${pkg}-${ver}-"; then
    echo "   WARNING: $pkg==$ver has no matching wheel in FOD"
    MISSING=1
  fi
done < <(grep -oE '^[a-zA-Z0-9._-]+==[^ \\]+' requirements.txt)
if [ "$MISSING" = "1" ]; then
  echo "FOD contents do not match requirements.txt — refusing to record hash."
  exit 1
fi

echo "5. Updating flake.nix..."
sed -i "s|outputHash = \".*\";|outputHash = \"$HASH\";|" flake.nix

echo "=== Done! ==="
echo "Commit the following files:"
echo "  - pyproject.toml"
echo "  - uv.lock"
echo "  - requirements.txt"
echo "  - flake.nix"
